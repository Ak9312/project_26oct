# Google Gemini API key (https://aistudio.google.com/apikey). Required.
GEMINI_API_KEY=

# Password for the admin page. Required. Use a long random value.
ADMIN_PASSWORD=

# Secret path for the admin page, without slashes, e.g. admin_k3x9q2v7.
# The admin page is then at https://your-site/admin_k3x9q2v7 and /admin returns 404.
ADMIN_PATH=

# Set automatically on Vercel when a Blob store is connected to the project.
# Leave empty locally to store files in ./.data instead.
BLOB_READ_WRITE_TOKEN=

# Optional model overrides
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-2

# Local testing without a Gemini key: deterministic offline stand-in (never use in production)
# MOCK_AI=1
