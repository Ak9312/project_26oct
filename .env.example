# Groq API key (https://console.groq.com/keys). Required: writes every answer, test question and grade.
GROQ_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey). Optional.
# Groq has no embedding models, so this adds meaning-based search (embeddings only, no answers).
# Without it, search uses keywords only.
GEMINI_API_KEY=

# Secret path for the admin page, without slashes. Required. At least 8 characters; use a long random value,
# e.g. admin_k3x9q2v7m1pz. The admin page is then at https://your-site/admin_k3x9q2v7m1pz and /admin returns 404.
# Anyone with this link has admin access; change it to revoke all old links.
ADMIN_PATH=

# Set automatically on Vercel when a Blob store is connected to the project.
# Leave empty locally to store files in ./.data instead.
BLOB_READ_WRITE_TOKEN=

# Optional model overrides. Groq's free limits are per model, so answers and evaluation use different models.
# GROQ_CHAT_MODEL=openai/gpt-oss-120b      # answers
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b   # answers when the main model hits its limit
# GROQ_EVAL_MODEL=openai/gpt-oss-20b       # writes test questions and grades answers
# GEMINI_EMBED_MODEL=gemini-embedding-2

# Local testing without any key: deterministic offline stand-in (never use in production)
# MOCK_AI=1
